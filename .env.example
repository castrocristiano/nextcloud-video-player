# ==============================================================================
# Configurações locais de desenvolvimento, SonarQube e Deploy Remoto (copie para .env)
# ==============================================================================

# URL do servidor SonarQube local/remoto (ex.: http://localhost:9000)
SONAR_HOST_URL=http://localhost:9000

# Token do projeto no SonarQube (nunca versione o .env com o token real)
SONAR_TOKEN=

# Configurações opcionais de deploy remoto (update_remote.sh)
REMOTE_HOST=
REMOTE_USER=cristiano
SSH_KEY=~/.ssh/id_ed25519
NEXTCLOUD_CONTAINER=nextcloud
NEXTCLOUD_APPS_DIR=/var/www/html/custom_apps
