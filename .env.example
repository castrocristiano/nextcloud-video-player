# ==============================================================================
# Configurações locais de desenvolvimento / SonarQube (copie para .env)
# ==============================================================================

# URL do servidor SonarQube local/remoto (ex.: http://localhost:9000)
SONAR_HOST_URL=http://localhost:9000

# Token do projeto no SonarQube (nunca versione o .env com o token real)
SONAR_TOKEN=
