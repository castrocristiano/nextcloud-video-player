{
    "name": "castrocristiano/nextcloud-video-player",
    "description": "Strictly read-only folder video catalog and HTML5 streaming player app for Nextcloud 30-32",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "OCA\\FolderVideoPlayer\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\FolderVideoPlayer\\Tests\\Unit\\": "tests/Unit/"
        },
        "files": [
            "tests/stubs/ocp.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "find appinfo lib tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-clover build/logs/clover.xml"
    }
}
